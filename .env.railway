# Railway production variables for the web service.
# If your database service is not named "MySQL", update the reference below.

APP_NAME="ARDC_PBT"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

# Generate locally with: php artisan key:generate --show
APP_KEY=

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
MYSQL_URL=${{MySQL.MYSQL_URL}}

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Keep uploads across deploys by attaching a Railway volume to this service.
# Mount path recommendation: /data
